{
  "name": "printsetu-print-agent",
  "version": "1.0.0",
  "description": "PrintSetu Printer App (Windows + Linux/CUPS): receives print orders from PrintSetu and sends them to the shop's printer.",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "node scripts/write-build-info.js && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "configure": "ts-node src/configure.ts",
    "test": "jest",
    "build:exe": "npm run build && node scripts/set-exe-details.js && pkg . --output release/PrintSetuAgent.exe",
    "build:exe:linux": "npm run build && pkg dist/index.js --config pkg.linux.json --output release/printsetu-agent-linux",
    "build:exe:all": "npm run build:exe && npm run build:exe:linux",
    "package": "node scripts/build-release-bundle.js",
    "build:installer": "sh scripts/build-windows-installer.sh"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.8.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "resedit": "1.7.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "pkg": {
    "assets": [
      "vendor/SumatraPDF-3.6.1-64.exe",
      "build-info.json"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  }
}
